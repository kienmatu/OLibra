# Copy to .env.prod on the VPS and fill in. Never commit .env.prod —
# .gitignore excludes it by exact name.
#
# Generate each secret with:
#
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32; echo
#
# The `tr` is not decoration. DATABASE_URL and MIGRATION_DATABASE_URL are
# assembled from these values inside compose.prod.yaml, and a `/`, `+` or `@`
# in a password breaks a postgres:// URL in a way that surfaces as an
# authentication failure — the least informative possible symptom for a
# password that is, in fact, correct.
#
# **Every comment in this file sits on its own line, and none trails a value.**
# Compose keeps everything after `=` in a .env file, comment included — it does
# not treat `#` as a comment marker the way a shell would. This file's sibling,
# .env.example, once wrote `POSTGRES_PASSWORD=   # required, no default` and
# thereby set the superuser's real password to that sentence, spaces and all;
# Postgres started and accepted it, so the comment's own claim was false in the
# one case it mattered. tests/architecture/env-example-has-no-inline-comments
# .test.ts now reads both files and fails on the shape.

# ── Domain ───────────────────────────────────────────────────────────────────
# The apex domain this deployment serves.
#
# `storage.<this>` must resolve here too — it is where a browser fetches every
# cover, avatar and condition photograph from, so it is a required second DNS A
# record and not an optional extra.
#
# `./deploy.sh --domain <d>` writes this line on the first deploy, so it can be
# left as CHANGE_ME until then. The preflight refuses to do anything at all
# while it still says CHANGE_ME.
APP_DOMAIN=CHANGE_ME

# Where Let's Encrypt sends certificate-expiry warnings.
#
# Optional — ACME registration and renewal both work without it. What you lose
# is the notification when renewal has been quietly failing, which is precisely
# the failure you want to hear about before the certificate expires rather than
# after.
ACME_EMAIL=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=olibra
POSTGRES_USER=olibra

# Required. The `olibra` superuser's password.
#
# Used by the `migrate` and `sweep` services, and by scripts/ops/backup.sh.
# Deliberately NOT given to the `app` service — see OLIBRA_POOL_PASSWORD below.
POSTGRES_PASSWORD=

# The host port Postgres is published on, bound to 127.0.0.1 and nothing else.
# Reachable over an SSH tunnel for psql; not reachable from the internet.
POSTGRES_PORT=5435

# Required. The password for `olibra_pool` — the non-superuser login role the
# application actually connects as.
#
# This split is CRITICAL 2 and not a formality: a superuser connection bypasses
# row level security unconditionally (DATABASE.md §3), so every RLS policy in
# this project would be inert on the one connection that serves public
# requests. `olibra_pool` is created by 20260808_13_pool_role.sql, which runs
# when ./deploy.sh reaches its migration step — so on a fresh VPS the
# application genuinely cannot connect until that has happened once.
OLIBRA_POOL_PASSWORD=

# ── Object storage ───────────────────────────────────────────────────────────
S3_REGION=us-east-1
S3_BUCKET=olibra

# Required. Becomes MinIO's root user.
S3_ACCESS_KEY_ID=

# Required, and at least 8 characters — MinIO refuses to start below that.
S3_SECRET_ACCESS_KEY=

S3_FORCE_PATH_STYLE=true

# S3_ENDPOINT and S3_PUBLIC_URL are deliberately absent from this file.
#
# compose.prod.yaml derives both, because they must differ and the difference is
# the thing that gets typed wrong: the server reaches MinIO at
# http://storage:9000 over the compose network, while a browser fetches from
# https://storage.${APP_DOMAIN}. Setting them by hand is how one of them ends up
# saying localhost — which renders every image on the live site broken while the
# application works perfectly and the server log says nothing.

# ── Locale ───────────────────────────────────────────────────────────────────
# Fixed by §4 of the requirements regardless of where the process runs.
TZ=Asia/Ho_Chi_Minh
