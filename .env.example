# Copy to .env and fill in. Never commit .env — .gitignore already excludes it.

# ── Application ──────────────────────────────────────────────────────────────
APP_PORT=3001

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=olibra
POSTGRES_USER=olibra
POSTGRES_PASSWORD=          # required, no default — compose refuses to start without it
POSTGRES_PORT=5435

# Used by the application. Inside compose the host is `db`; running the app
# outside compose against the same database, it is localhost.
DATABASE_URL=postgres://olibra:CHANGE_ME@localhost:5435/olibra

# ── Object storage (S3-compatible) ───────────────────────────────────────────
# The application speaks S3 and nothing else. MinIO is what runs in compose,
# but these variables are deliberately provider-neutral: pointing them at AWS
# S3, Cloudflare R2 or Backblaze B2 is the whole of the migration.
#
#   MinIO (compose)   S3_ENDPOINT=http://storage:9000   S3_FORCE_PATH_STYLE=true
#   AWS S3            S3_ENDPOINT=                      S3_FORCE_PATH_STYLE=false
#   Cloudflare R2     S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#                                                       S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=olibra
S3_ACCESS_KEY_ID=           # required
S3_SECRET_ACCESS_KEY=       # required, at least 8 characters for MinIO
S3_FORCE_PATH_STYLE=true

# Where a browser fetches an object from. Differs from S3_ENDPOINT whenever the
# app reaches storage over the internal network but the browser does not.
S3_PUBLIC_URL=http://localhost:9000

S3_PORT=9000
S3_CONSOLE_PORT=9001

# ── Locale ───────────────────────────────────────────────────────────────────
# Fixed by §4 of the requirements regardless of where the process runs.
TZ=Asia/Ho_Chi_Minh

# ── Tests ────────────────────────────────────────────────────────────────────
# The test database is a separate compose service on its own port, behind the
# `test` profile so an ordinary `up` does not start it:
#
#   docker compose --profile test up -d db-test
#
# It is never the development database: the suite truncates every table, and
# tests/support/env.ts refuses any URL that does not name olibra_test.
#
# NOTE: the port below is duplicated, not derived — POSTGRES_TEST_PORT feeds
# db-test's compose port mapping, TEST_DATABASE_URL's port is a separate
# literal read directly by the app/test process. Changing one without the
# other silently points the suite at a closed port instead of db-test.
POSTGRES_TEST_PORT=5436
TEST_DATABASE_URL=postgres://olibra:olibra@localhost:5436/olibra_test
