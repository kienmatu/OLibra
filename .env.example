# Copy to .env and fill in. Never commit .env — .gitignore already excludes it.
#
# EVERY VARIABLE IN THIS FILE IS ONE THE APPLICATION ACTUALLY READS.
#
# It used to carry 167 lines above this point describing the Next.js stack:
# POSTGRES_DB/USER/PASSWORD/PORT, OLIBRA_POOL_PASSWORD, DATABASE_URL,
# MIGRATION_DATABASE_URL, the six S3_* variables for MinIO, TZ, and three
# TEST_*_DATABASE_URLs. Phase 4 deleted that application; the post-cutover
# commit deleted its configuration, after checking each of the eighteen
# against app/, config/, database/, routes/, tests/, docker/, deploy/ and
# .github/ and finding NO reader for any of them.
#
# That was not tidiness. An operator following the old file would have stood
# up PostgreSQL and MinIO for an application that speaks MariaDB and writes
# avatars to local disk — and the file gave them no way to tell which half
# was live.
#
# The removed text is not lost: `git show v0.2.0:.env.example` has all of it.

# ── The application (docker-compose.laravel.yml) ─────────────────────────────
# This section used to be headed "Laravel stack" and described itself as
# running "alongside the Next.js stack above for the whole migration". There
# is no stack above and no migration in progress; this is the application.
#
# The ports below are still the migration's — 8100 for the app, 3310 for the
# database — chosen to avoid colliding with the Next.js stack while both ran.
# Nothing needs them to stay that way now; they are left alone because a
# running installation's .env already has them.
APP_NAME=OLibra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_TIMEZONE=UTC
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=olibra
DB_USERNAME=olibra
DB_PASSWORD=secret

# hashed-database: App\Support\HashedDatabaseSessionHandler, registered in
# AppServiceProvider. Stores sha256(session id), never the raw id (Task 16).
SESSION_DRIVER=hashed-database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Where readers' photographs are written and how they are addressed
# (config/filesystems.php's `avatars` disk, Phase 3c-i). The defaults below
# are what `php artisan storage:link` serves, and they are correct in
# development and under either of docs/HOSTING.md's first two docroot
# options.
#
# UNDER THE SHIM DOCROOT — deploy/public_html-index.php.template, Task 21's
# coded default — `public/` and `public_html/` are separate directories and
# post-deploy.sh syncs only `build/` and `.htaccess` between them, so a
# `public/storage` symlink is never reached by the web server. Set both of
# these instead, to a path INSIDE the served docroot:
#
#   AVATAR_DISK_ROOT=/home/<account>/public_html/storage/avatars
#   AVATAR_DISK_URL=https://<host>/storage/avatars
#
# AVATAR_DISK_ROOT=
# AVATAR_DISK_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# argon2id is the local/CI default (docs/HOSTING.md's "The hashing
# decision"): every environment this repo controls is known to have it.
# The production host's real .env (hand-written at deploy, never generated
# from this file) instead follows row 5 of docs/HOSTING.md — bcrypt until
# the PASSWORD_ARGON2ID survey confirms the host has argon2id. Do not copy
# this line verbatim into a production .env without checking that row;
# deploy/post-deploy.sh refuses to proceed if HASH_DRIVER=argon2id is set
# on a host that lacks it, but only if the guard runs at all.
HASH_DRIVER=argon2id

# public/hot exists whenever the vite service is running (docker-compose.laravel.yml),
# which makes Vite::isRunningHot() true and Inertia\Ssr\HttpGateway::dispatch()
# skip the bundle-exists check entirely and POST every render to the vite dev
# server's /__inertia_ssr path -- not a rendering service. phpunit.xml forces
# this to false with <server> for the suite, and it ships false here too:
# there is no SSR bundle, no `ssr` input in vite.config.ts, and no
# `inertia:start-ssr` runtime, so leaving this true buys nothing today and
# only means every dev render fires a doomed POST whose failure is silent
# (handleSsrFailure() just dispatches an event; throw_on_error is false).
# Flip to true only once an actual SSR bundle/runtime is wired up.
INERTIA_SSR_ENABLED=false
# Never true here. See config/inertia.php's devtools comment for what turning
# this on in a local-environment app exposes.
INERTIA_DEVTOOLS_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

# Host port overrides for local docker, when the defaults are already taken.
# LARAVEL_APP_PORT=8100
# LARAVEL_VITE_PORT=5175
# LARAVEL_DB_PORT=3310
