{
    "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
    "files": {
        "includes": ["resources/js/**", "vite.config.ts"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "noJsxLiterals": "error"
            }
        }
    },
    "assist": {
        "actions": {
            "source": { "organizeImports": "on" }
        }
    },
    "overrides": [
        {
            "includes": ["resources/js/components/ui/**"],
            "linter": {
                "rules": {
                    "style": { "noJsxLiterals": "off" },
                    "a11y": { "noSvgWithoutTitle": "off", "useSemanticElements": "off" }
                }
            }
        }
    ]
}
