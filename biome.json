{
    "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
    "files": {
        "includes": ["resources/js/**", "vite.config.ts"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "noJsxLiterals": "error"
            }
        }
    },
    "assist": {
        "actions": {
            "source": { "organizeImports": "on" }
        }
    },
    "overrides": [
        {
            "includes": ["resources/js/components/ui/**"],
            "linter": {
                "rules": {
                    "style": { "noJsxLiterals": "off" },
                    "a11y": {
                        "noSvgWithoutTitle": "off",
                        "useSemanticElements": "off",
                        "useFocusableInteractive": "off"
                    },
                    "correctness": { "useExhaustiveDependencies": "off" },
                    "suspicious": { "noDocumentCookie": "off" }
                }
            }
        },
        {
            "includes": [
                "resources/js/pages/auth/**",
                "resources/js/pages/settings/**",
                "resources/js/pages/welcome.tsx",
                "resources/js/layouts/**",
                "resources/js/components/app-header.tsx",
                "resources/js/components/app-logo.tsx",
                "resources/js/components/app-logo-icon.tsx",
                "resources/js/components/appearance-dropdown.tsx",
                "resources/js/components/appearance-tabs.tsx",
                "resources/js/components/breadcrumbs.tsx",
                "resources/js/components/delete-user.tsx",
                "resources/js/components/heading.tsx",
                "resources/js/components/nav-main.tsx",
                "resources/js/components/nav-user.tsx",
                "resources/js/components/user-menu-content.tsx",
                "resources/js/hooks/use-appearance.tsx"
            ],
            "linter": {
                "rules": {
                    "style": { "noJsxLiterals": "off" }
                }
            }
        },
        {
            "includes": ["resources/js/pages/auth/**"],
            "linter": {
                "rules": {
                    "a11y": { "noPositiveTabindex": "off" }
                }
            }
        },
        {
            "includes": [
                "resources/js/pages/welcome.tsx",
                "resources/js/components/app-logo-icon.tsx"
            ],
            "linter": {
                "rules": {
                    "a11y": { "noSvgWithoutTitle": "off" }
                }
            }
        },
        {
            "includes": [
                "resources/js/components/app-header.tsx",
                "resources/js/components/breadcrumbs.tsx"
            ],
            "linter": {
                "rules": {
                    "suspicious": { "noArrayIndexKey": "off" }
                }
            }
        },
        {
            "includes": ["resources/js/components/appearance-tabs.tsx"],
            "linter": {
                "rules": {
                    "a11y": { "useButtonType": "off" }
                }
            }
        },
        {
            "includes": ["resources/js/hooks/use-appearance.tsx"],
            "linter": {
                "rules": {
                    "correctness": { "useExhaustiveDependencies": "off" }
                }
            }
        }
    ]
}
