# Temporary files. Everything except the README that documents the convention.
/.artifacts/*
!/.artifacts/README.md

# Git worktrees live inside the project, never beside it.
/.worktrees/

# Dependencies
/node_modules
.pnp
.pnp.*

# Build output
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel

# Environment. .env.example is committed and documents every variable;
# real values never are.
.env
.env.local
.env.*.local
.env.backup
.env.production

# Test output
/coverage
/playwright-report
/test-results

# Editors and OS
/.fleet
/.idea
/.nova
/.vscode
/.zed
.DS_Store
npm-debug.log*
yarn-error.log*

# Container data. Bind-mounted from compose.yaml so the parish's records
# survive `docker compose down -v` — which also means they must never be
# committed.
/data/
