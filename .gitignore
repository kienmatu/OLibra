# Temporary files. Everything except the README that documents the convention.
/.artifacts/*
!/.artifacts/README.md

# Git worktrees live inside the project, never beside it.
/.worktrees/

# A Claude Code worktree, same shape as /.worktrees/ above but a separate
# convention this file did not cover. Found by the QA remediation branch's
# Task 6, whose reported `bun run lint` failure turned out to be 100% of 284
# errors coming from a stray `.claude/worktrees/*/.next/` left by another
# session — unignored, so ESLint (and everything else that walks the tree)
# happily descended into another branch's build output.
/.claude/worktrees/

# Dependencies
/node_modules
/old_next/node_modules
.pnp
.pnp.*

# Build output (old_next/, the Next.js reference app — see AGENTS.md)
/old_next/.next/
/old_next/out/
/old_next/build
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel

# Environment. .env.example and .env.prod.example are committed and document
# every variable; real values never are.
#
# `.env.prod` is listed explicitly. `.env.production` above does not cover it —
# these are exact names, not prefixes — and the file it names is the one holding
# the production superuser password, so the gap was worth closing by hand rather
# than trusting the neighbouring line to look close enough.
.env
.env.local
.env.*.local
.env.backup
.env.production
.env.prod

# Database dumps and mirrored objects. Never committed — a dump holds every
# personal field in the system, including children's names and dates of birth.
backups/

# Test output (old_next/)
/old_next/coverage
/old_next/playwright-report
/old_next/test-results

# Editors and OS
/.fleet
/.idea
/.nova
/.vscode
/.zed
.DS_Store
npm-debug.log*
yarn-error.log*

# Container data. Bind-mounted from old_next/compose.yaml (the Next.js
# reference app) so the parish's records survive `docker compose down -v` —
# which also means they must never be committed.
#
# `/data/` (the pre-move location) is kept here too, deliberately not
# replaced by `/old_next/data/` alone: every checkout that existed before
# this move has a real, populated `data/postgres` at the repo root, and
# `docker compose` there does not delete it — it just stops being pointed at
# it once the compose file itself is under `old_next/`. Without this line,
# `git status`/`git add .` on any such pre-existing checkout would offer up
# a live PostgreSQL cluster (children's names and dates of birth) for commit.
# See `old_next/AGENTS.md` for the one-time `mv data old_next/data`.
/data/
/old_next/data/
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/bootstrap/ssr
/database/database.sqlite
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
auth.json
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
