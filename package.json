{
  "name": "olibra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "check:diagrams": "bun run scripts/check-mermaid.mjs",
    "check:links": "bun run scripts/check-links.mjs",
    "db:migrate": "bun run src/db/migrate-cli.ts",
    "db:seed": "bun run src/db/seed-cli.ts",
    "db:sweep": "bun run src/db/sweep-cli.ts",
    "laravel:dev": "vite",
    "laravel:build": "vite build",
    "laravel:typecheck": "tsc -p tsconfig.laravel.json --noEmit",
    "laravel:lint": "biome check resources",
    "laravel:lint:fix": "biome check --write resources"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@headlessui/react": "^2.2.0",
