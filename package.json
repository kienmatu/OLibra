{
  "name": "olibra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "check:diagrams": "bun run scripts/check-mermaid.mjs",
    "check:links": "bun run scripts/check-links.mjs",
    "db:migrate": "bun run src/db/migrate-cli.ts",
    "db:seed": "bun run src/db/seed-cli.ts",
    "db:sweep": "bun run src/db/sweep-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@node-rs/argon2": "^2.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "mermaid": "^11.16.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^25.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9",
    "vitest": "^3"
  }
}
