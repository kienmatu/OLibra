# OLibra — production reverse proxy and TLS.
#
# Caddy obtains and renews certificates in-process, which is the whole reason
# this file is short: there is no ACME challenge webroot to arrange, no
# `options-ssl-nginx.conf` to fetch from a raw GitHub URL, no DH params to
# generate, and no systemd timer whose reload target has to live outside the
# stack. HTTP-to-HTTPS redirection is automatic and needs no server block of
# its own.
#
# `{$APP_DOMAIN}` is Caddy's own environment substitution, filled from the
# variable compose passes the container. Nothing here is hardcoded to a domain,
# so this file deploys a second parish unchanged.
#
# The certificates and the ACME account key live in the `caddy-data` volume.
# **Do not wipe it casually** — Let's Encrypt allows five duplicate certificates
# per registered domain per week, so a needless re-issue can cost a week of
# serving no TLS, which no amount of redeploying fixes.
{
	# Where Let's Encrypt sends expiry warnings. Optional — registration and
	# renewal both work without it — but without it nobody is told when renewal
	# has been quietly failing, which is the one thing you want to hear about
	# before the certificate expires rather than after.
	email {$ACME_EMAIL}
}

# ── The application ──────────────────────────────────────────────────────────
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# SAMEORIGIN rather than DENY. The QR label sheet is a PDF the browser
		# renders in place (`/quan-ly/xuat/ma-qr`), and DENY breaks that preview
		# in some browsers — a manager printing labels is a first-class flow
		# here, not an edge case.
		X-Frame-Options "SAMEORIGIN"
	}

	# `reverse_proxy` sets X-Forwarded-Host, X-Forwarded-Proto and
	# X-Forwarded-For by itself, and the first of those is load-bearing: it is
	# what Next compares a Server Action's `Origin` against. See
	# next.config.ts's `allowedOrigins`, which admits {$APP_DOMAIN} explicitly
	# rather than relying on this alone.
	reverse_proxy app:3000 {
		# The application streams nothing long-lived, but a slow first render on
		# a cold container after a deploy can outlast the default. 60s is well
		# under the point at which a volunteer would have given up anyway.
		transport http {
			response_header_timeout 60s
		}
	}

	log {
		output file /var/log/caddy/app.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# ── Object storage ───────────────────────────────────────────────────────────
# Every cover, avatar and condition photograph is an <img> tag pointing here —
# `S3_PUBLIC_URL` in compose.prod.yaml is `https://storage.{$APP_DOMAIN}`, and
# this block is what answers it. Without this hostname the application works
# perfectly and every image on the site is broken.
#
# The bucket grants anonymous `s3:GetObject` and nothing else — no listing, no
# writing — enforced by compose.prod.yaml's storage-init sidecar and asserted by
# tests/architecture/compose-grants-only-get-object.test.ts.
#
# MinIO's console (:9001) is deliberately absent from this file and publishes no
# port at all. It is a login form for the root credentials that also hold every
# child's photograph; reach it over an SSH tunnel instead. docs/DEPLOYMENT.md
# has the command.
storage.{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# These objects are fetched cross-origin by the application's own pages.
		Access-Control-Allow-Origin "https://{$APP_DOMAIN}"
	}

	reverse_proxy storage:9000
	# `Host` is passed through unchanged, which MinIO needs: it signs and
	# verifies requests against the host it was addressed by, and rewriting the
	# header here would make every presigned URL fail its own signature check.

	log {
		output file /var/log/caddy/storage.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
