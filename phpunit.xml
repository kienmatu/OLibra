<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" everywhere or PHPUnit leaves any variable already
            present in the real environment untouched, and a stray APP_ENV or
            DB_DATABASE from the shell wins: the suite then runs against the
            DEVELOPMENT database with APP_ENV=local — silently, tests passing,
            data destroyed, CSRF no longer bypassed. EnvironmentTest asserts
            the outcome these lines exist to produce.

            force="true" on <env> is not the whole guard, though. Laravel's
            env()/config() resolve through vlucas/phpdotenv's Repository,
            which is built with ServerConstAdapter (reads $_SERVER) BEFORE
            EnvConstAdapter (reads $_ENV) — see
            vendor/vlucas/phpdotenv/src/Repository/RepositoryBuilder.php's
            DEFAULT_ADAPTERS. PHP's CLI SAPI copies every real container
            environment variable into $_SERVER at process start (that is what
            an `environment:`/`env_file:` entry becomes), but PHPUnit's own
            PhpHandler::handleEnvVariables() only ever touches getenv()/
            putenv() and $_ENV — it never writes $_SERVER, force or not.
            A stray DB_DATABASE already sitting in the container's real
            environment therefore keeps winning through $_SERVER even with
            force="true" above; verified by hand with a docker compose exec
            that injects DB_DATABASE=olibra and filters php artisan test to
            EnvironmentTest, which still failed until the <server> block
            below was added.
            <server> entries are unconditional overwrites of $_SERVER
            (handleServerVariables(), no force attribute exists or is
            needed), so they close the gap the <env> block leaves open.

            DB_URL is neutralised to empty, <env> and <server> both: Laravel's
            ConfigurationUrlParser::parseConfiguration() merges a DB_URL's
            database/host/user OVER the 'mariadb' connection array above at
            connect time (config/database.php sets 'url' => env('DB_URL')). A
            stray DB_URL would leave config('database.connections.mariadb.database')
            reporting 'olibra_testing' correctly while the live connection
            went wherever DB_URL pointed — config alone cannot see this,
            which is why EnvironmentTest also asserts
            DB::connection()->getDatabaseName().
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!--
            The real engine, not sqlite: generated columns, CHECK constraints,
            SIGNAL triggers and binary collations are the subject matter of
            this phase, and only MariaDB exercises them.
        -->
        <env name="DB_CONNECTION" value="mariadb" force="true"/>
        <env name="DB_DATABASE" value="olibra_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="HASH_DRIVER" value="argon2id" force="true"/>
        <!--
            BCRYPT_ROUNDS is dead weight under argon2id (this app hashes with
            argon2id everywhere — see HASH_DRIVER above and docs/HOSTING.md
            row 5). ARGON_MEMORY/ARGON_TIME are forced down from the 64
            MiB/4-pass production defaults so every hashing-touching test in
            the remaining 19 tasks doesn't pay full cost.
        -->
        <env name="ARGON_MEMORY" value="1024" force="true"/>
        <env name="ARGON_TIME" value="1" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="mariadb"/>
        <server name="DB_DATABASE" value="olibra_testing"/>
        <server name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="HASH_DRIVER" value="argon2id"/>
        <!--
            Inertia ships INERTIA_SSR_ENABLED defaulting to true, and
            Inertia\Ssr\HttpGateway::dispatch() only skips SSR when there is
            no bundle WHEN Vite::isRunningHot() is false. docker-compose.laravel.yml
            runs a continuous vite service, so public/hot exists for the whole
            life of the container and isRunningHot() is true — the
            bundle-exists check is skipped entirely and every Inertia render
            POSTs to the vite dev server's /__inertia_ssr path, which is not a
            rendering service. Feature tests that render an Inertia page would
            hit that stray HTTP call with no idea why.

            This belongs in <server> rather than <env> for the reason the note
            above gives: <server> outranks whatever the container leaks, so a
            developer who later sets INERTIA_SSR_ENABLED=true in the project
            .env to work on SSR cannot silently reintroduce the failure.
            InertiaSsrTest pins both the config value and the behaviour.
        -->
        <server name="INERTIA_SSR_ENABLED" value="false"/>
    </php>
</phpunit>
